digraph G { rankdir=BT; graph [fontname="Helvetica", fontsize=11, nodesep=0.5];
node [shape=box, style="rounded,filled", fillcolor="#eef3fb", fontname="Helvetica", fontsize=10];
std_exc [label="std::exception"]; rt [label="std::runtime_error"];
BE [label="BillingError"]; NC [label="NegativeChargeError"]; CE [label="ClaimError\n(\"exceeds cover\")"];
